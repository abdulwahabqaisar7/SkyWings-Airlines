# SkyWings Airlines - Docker environment template
#
#   cp .env.example .env      (PowerShell: Copy-Item .env.example .env)
#
# Then replace every CHANGE_ME below with your own values.
# .env is git-ignored - never commit real credentials.

# --- MySQL container -------------------------------------------------------
# Root password: used only by the MySQL container itself (init + healthcheck).
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_password

# Dedicated application account. The app connects with this user, not root.
MYSQL_USER=skywings
MYSQL_PASSWORD=CHANGE_ME_app_password

# Database name. Must match the database created in database/schema/schema.sql.
MYSQL_DATABASE=skywings_airlines

# Host port for connecting external tools (Workbench, mysql CLI) to the
# container. 3307 avoids clashing with any MySQL already on the host.
MYSQL_HOST_PORT=3307

# --- Application -----------------------------------------------------------
# Secret used to sign JWTs. Use a long random string, e.g.
#   PowerShell: [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
JWT_SECRET=CHANGE_ME_long_random_secret

# Host port for the web app. frontend/js/main.js calls http://localhost:3000/api
# when served from localhost, so leave this at 3000 unless you edit that file.
APP_HOST_PORT=3000

# production | development (development also returns stack traces in API errors)
NODE_ENV=production

# --- Seeding ---------------------------------------------------------------
# false -> only the schema's sample data + default admin/user password hashes.
# true  -> additionally load 100+ demo users, bookings, passengers and flights.
# Only takes effect on the first run (tracked by the seed_state volume).
SEED_SAMPLE_DATA=false
